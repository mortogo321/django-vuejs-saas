# Production defaults — safe to commit. Inject real DJANGO_SECRET_KEY and
# POSTGRES_PASSWORD at deploy time via the orchestrator.
DEBUG=False
DJANGO_SECRET_KEY=change-me-in-orchestrator
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
POSTGRES_DB=saas
POSTGRES_USER=saas
POSTGRES_PASSWORD=change-me-in-orchestrator
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO
